# Application
PORT=8080
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=30
HTTP_SHUTDOWN_TIMEOUT=10
ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=roly_poly
DB_SSL_MODE=disable

# CORS
CORS_ALLOWED_ORIGINS=*

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# OpenTelemetry (optional — leave empty to disable tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=roly-poly
